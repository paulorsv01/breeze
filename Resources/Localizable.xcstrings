    "Speed increases immediately as the Mac warms up. Small temperature drops hold the current speed; cooling beyond this margin gradually slows the fans.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speed increases immediately as the Mac warms up. Small temperature drops hold the current speed; cooling beyond this margin gradually slows the fans."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La velocidad puede subir al calentarse el Mac. Las pequeñas bajadas mantienen la velocidad; al enfriarse más allá de este margen, disminuye gradualmente."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A rotação pode subir assim que o Mac aquece. Pequenas quedas de temperatura mantêm a rotação; ao esfriar além desta margem, ela diminui gradualmente."
          }
        }
      }
    },
