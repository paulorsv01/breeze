{
  "sourceLanguage": "en",
  "strings": {
    "Adjust the curve below. Changes apply when you save.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust the curve below. Changes apply when you save."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta la curva. Los cambios se aplican al guardar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste a curva abaixo. As mudanças são aplicadas ao salvar."
          }
        }
      }
    },
    "Allow Breeze in Login Items \u0026 Extensions in System Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Breeze in Login Items \u0026 Extensions in System Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriza Breeze en Ítems de inicio y extensiones, en Ajustes del Sistema."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorize o Breeze em Itens de Início e Extensões, nos Ajustes do Sistema."
          }
        }
      }
    },
    "Another instance is controlling the fans.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another instance is controlling the fans."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra instancia está controlando los ventiladores."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra instância está controlando as ventoinhas."
          }
        }
      }
    },
    "At 100%, this preset always runs at maximum speed. Lower the minimum to use a temperature curve.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At 100%, this preset always runs at maximum speed. Lower the minimum to use a temperature curve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al 100%, este perfil mantiene la velocidad máxima. Reduce la velocidad inicial para usar una curva de temperatura."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em 100%, este preset mantém a rotação máxima. Reduza a rotação inicial para usar uma curva de temperatura."
          }
        }
      }
    },
    "Automatic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático"
          }
        }
      }
    },
    "Automatic mode is managed by macOS. Custom presets respect hardware limits and reach maximum speed if temperature readings are unavailable.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic mode is managed by macOS. Custom presets respect hardware limits and reach maximum speed if temperature readings are unavailable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS gestiona el modo automático. Los perfiles respetan los límites del hardware y usan la velocidad máxima si no hay lectura de temperatura."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo automático é gerenciado pelo macOS. Os presets respeitam os limites do hardware e usam rotação máxima se a temperatura estiver indisponível."
          }
        }
      }
    },
    "Automatic mode stays with macOS. Presets always respect each fan’s limits.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic mode stays with macOS. Presets always respect each fan’s limits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS sigue gestionando el modo automático. Los perfiles respetan los límites de cada ventilador."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O automático continua com o macOS. Os presets respeitam os limites de cada ventoinha."
          }
        }
      }
    },
